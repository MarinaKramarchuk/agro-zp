@echo off
chcp 65001 >nul
cd /d "%~dp0"

if not exist "%~dp0runtime\node.exe" (
  echo Не знайдено runtime\node.exe - схоже, папку скопійовано не повністю.
  echo Скопіюйте всю папку agro-zp цілком, включно з підпапкою runtime.
  echo.
  pause
  exit /b 1
)

cd /d "%~dp0backend"

rem migrate.js безпечний для повторного запуску - лише додає нові таблиці й
rem колонки, не займає часу, якщо додавати нічого. Виконуємо щоразу, а не
rem тільки при першому запуску - інакше після оновлення коду в базі не
rem з'являться нові таблиці, і застосунок впаде на першому ж їх використанні.
echo Готую базу даних...
"%~dp0runtime\node.exe" "src\db\migrate.js"
echo.

echo Запускаю Агро-Зарплату...
rem run-app-hidden.vbs: піднімає сервер приховано (без вікна), відкриває вікно
rem програми і сам чекає, поки користувач те вікно закриє - тоді сам зупиняє
rem сервер. Тобто зупинка = просто закрити вікно програми, без нічого зайвого.
start "" wscript.exe "%~dp0runtime\run-app-hidden.vbs" "%~dp0"

echo.
echo Готово. Щоб зупинити - просто закрийте вікно програми.
echo.
echo Це вікно закриється само за 3 секунди.
timeout /t 3 /nobreak >nul
